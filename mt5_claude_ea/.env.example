# Copy to .env (never commit .env). The bridge fails closed: anything missing/invalid => HOLD.

# Shared secret between EA and bridge (NOT the Anthropic key). Generate: python -m bridge --new-token
# Put the same value in  <MT5 data folder>/MQL5/Files/claude_bridge_token.txt
BRIDGE_TOKEN=replace_me
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# AI is OFF by default. With AI_ENABLED=false every signal is HOLD.
AI_ENABLED=false
ANTHROPIC_API_KEY=replace_me
# Model ids are checked against the Models API before first use; unknown id => HOLD.
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_MAX_TOKENS=4096
AI_TIMEOUT=20
DECISION_DEADLINE_SEC=75

# Estimated AI spend allowed per UTC day. Reached => HOLD until the next day. 0 disables the cap.
MAX_DAILY_COST_USD=10
# raw = real prices; normalized = candles in ATR units relative to the last close
# (use normalized for historical replays, so price levels cannot reveal the period)
PROMPT_PRICE_MODE=raw

# Optional 3-model voting (OFF by default). Exactly 3 distinct ids, all must answer.
VOTING_ENABLED=false
VOTE_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5

# Retry / circuit breaker (background worker only)
MAX_RETRIES=5
BACKOFF_BASE_SEC=0.5
BACKOFF_MAX_SEC=8
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SEC=300

# Guards
SYMBOL_ALLOWLIST=XAUUSD,XAUUSD.sc
STALE_MAX_AGE_SEC=240
CLOCK_SKEW_SEC=5

# State / logs
BRIDGE_DB_PATH=bridge_state.sqlite3
BRIDGE_AUDIT_PATH=logs/bridge_audit.jsonl
RETENTION_DAYS=14
# Optional override of the cost-estimate table: {"model-id":[input_usd_per_mtok, output_usd_per_mtok]}
# PRICE_TABLE_JSON=
