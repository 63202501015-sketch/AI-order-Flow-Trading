// STANDALONE BUILD - generated by tools_mql_bundle.py from the modular sources.
// Do not edit here; edit EA/Include/ClaudeEA/*.mqh and regenerate.

//+------------------------------------------------------------------+
//|                                                Claude_AI_MT5.mq5 |
//| AI-assisted EA: a local Python bridge returns BUY/SELL/HOLD for   |
//| each closed M5 bar; THIS file decides whether anything is traded. |
//|                                                                   |
//| Safety model                                                      |
//|  - InpAllowOrders=false by default: signals are logged, no orders.|
//|  - Every bridge/HTTP/schema failure is HOLD (fail closed).        |
//|  - Protective management (BE, trailing, daily stop, quick profit) |
//|    runs on every tick and never depends on the bridge or the AI.  |
//|  - The AI output is three fields. It cannot set lot size, stops,  |
//|    limits or any other parameter, and its text is never executed. |
//|  - Only positions with this magic number on this symbol are ever  |
//|    modified or closed.                                            |
//|                                                                   |
//| NOT validated for real-money trading. See docs/TEST_REPORT.md.    |
//+------------------------------------------------------------------+
#property copyright "Research / demo use. No profitability claim."
#property version   "1.00"
#property description "Claude AI signal EA (M5). Orders are OFF by default. Demo/tester only until accepted."

//==================== begin Sessions.mqh ====================
//+------------------------------------------------------------------+
//| Sessions.mqh - DST-aware London / New York session gate.          |
//| MQL5 has no IANA time-zone database, so the EU and US daylight    |
//| saving calendars are computed arithmetically. Mirrors             |
//| refmodel/sessions.py, which is tested against IANA zoneinfo.      |
//+------------------------------------------------------------------+

enum ENUM_CAI_SERVER_TIME_MODE
  {
   CAI_SERVER_TIME_AUTO   = 0,   // AUTO: TimeTradeServer()-TimeGMT() (live only)
   CAI_SERVER_TIME_MANUAL = 1    // MANUAL: standard offset + DST rule (required in tester)
  };

enum ENUM_CAI_DST_RULE
  {
   CAI_DST_NONE = 0,             // broker clock never changes
   CAI_DST_EU   = 1,             // +1h during EU summer time
   CAI_DST_US   = 2              // +1h during US daylight time
  };

//+------------------------------------------------------------------+
datetime CaiMakeTime(const int y, const int mo, const int d, const int h)
  {
   MqlDateTime s;
   ZeroMemory(s);
   s.year = y; s.mon = mo; s.day = d; s.hour = h;
   return StructToTime(s);
  }
//+------------------------------------------------------------------+
int CaiDayOfWeek(const int y, const int mo, const int d)      // 0 = Sunday
  {
   MqlDateTime s;
   TimeToStruct(CaiMakeTime(y, mo, d, 0), s);
   return s.day_of_week;
  }
//+------------------------------------------------------------------+
int CaiNthSunday(const int y, const int mo, const int n)
  {
   int dow = CaiDayOfWeek(y, mo, 1);
   return 1 + (7 - dow) % 7 + 7 * (n - 1);
  }
//+------------------------------------------------------------------+
int CaiLastSunday31(const int y, const int mo)                // for 31-day months (March, October)
  {
   return 31 - CaiDayOfWeek(y, mo, 31);
  }
//+------------------------------------------------------------------+
//| EU/UK: last Sunday of March 01:00 UTC .. last Sunday of Oct 01:00 |
//+------------------------------------------------------------------+
bool CaiEuDst(const datetime utc)
  {
   MqlDateTime s;
   TimeToStruct(utc, s);
   datetime start = CaiMakeTime(s.year, 3,  CaiLastSunday31(s.year, 3),  1);
   datetime end   = CaiMakeTime(s.year, 10, CaiLastSunday31(s.year, 10), 1);
   return (utc >= start && utc < end);
  }
//+------------------------------------------------------------------+
//| US: 2nd Sunday of March 07:00 UTC .. 1st Sunday of Nov 06:00 UTC  |
//+------------------------------------------------------------------+
bool CaiUsDst(const datetime utc)
  {
   MqlDateTime s;
   TimeToStruct(utc, s);
   datetime start = CaiMakeTime(s.year, 3,  CaiNthSunday(s.year, 3, 2),  7);
   datetime end   = CaiMakeTime(s.year, 11, CaiNthSunday(s.year, 11, 1), 6);
   return (utc >= start && utc < end);
  }
//+------------------------------------------------------------------+
int CaiLondonOffset(const datetime utc)  { return CaiEuDst(utc) ? 3600 : 0; }
int CaiNewYorkOffset(const datetime utc) { return CaiUsDst(utc) ? -4 * 3600 : -5 * 3600; }
//+------------------------------------------------------------------+
//| Window in minutes after local midnight: [startMin, endMin).       |
//| Saturday and Sunday (local) are always closed.                    |
//+------------------------------------------------------------------+
bool CaiInWindow(const datetime utc, const int offsetSec, const int startMin, const int endMin)
  {
   long local = (long)utc + offsetSec;
   if(local < 0)
      return false;
   int dow = (int)((local / 86400 + 4) % 7);                  // 1970-01-01 was a Thursday; 0 = Sunday
   if(dow == 0 || dow == 6)
      return false;
   int minute = (int)((local % 86400) / 60);
   return (minute >= startMin && minute < endMin);
  }
//+------------------------------------------------------------------+
int CaiHhmmToMin(const int hhmm) { return (hhmm / 100) * 60 + (hhmm % 100); }
bool CaiHhmmValid(const int hhmm) { return (hhmm >= 0 && hhmm <= 2400 && hhmm % 100 < 60); }
//+------------------------------------------------------------------+
//| Returns true and the session name if utc falls in an enabled      |
//| session. Asia (Tokyo, UTC+9, no DST) is OFF unless enabled.       |
//+------------------------------------------------------------------+
bool CaiSessionAllowed(const datetime utc,
                       const bool useLondon, const int lonStart, const int lonEnd,
                       const bool useNewYork, const int nyStart, const int nyEnd,
                       const bool useAsia, const int asiaStart, const int asiaEnd,
                       string &name)
  {
   name = "NONE";
   if(useLondon && CaiInWindow(utc, CaiLondonOffset(utc), CaiHhmmToMin(lonStart), CaiHhmmToMin(lonEnd)))
     { name = "LONDON"; return true; }
   if(useNewYork && CaiInWindow(utc, CaiNewYorkOffset(utc), CaiHhmmToMin(nyStart), CaiHhmmToMin(nyEnd)))
     { name = "NEW_YORK"; return true; }
   if(useAsia && CaiInWindow(utc, 9 * 3600, CaiHhmmToMin(asiaStart), CaiHhmmToMin(asiaEnd)))
     { name = "ASIA"; return true; }
   return false;
  }
//+------------------------------------------------------------------+
bool CaiDstByRule(const ENUM_CAI_DST_RULE rule, const datetime utc)
  {
   if(rule == CAI_DST_EU) return CaiEuDst(utc);
   if(rule == CAI_DST_US) return CaiUsDst(utc);
   return false;
  }
//+------------------------------------------------------------------+
//| Manual conversion of a broker-server timestamp to UTC.            |
//+------------------------------------------------------------------+
datetime CaiServerToUtcManual(const datetime server, const int stdOffsetHours, const ENUM_CAI_DST_RULE rule)
  {
   datetime utc = server - stdOffsetHours * 3600;
   utc = server - (stdOffsetHours + (CaiDstByRule(rule, utc) ? 1 : 0)) * 3600;
   return server - (stdOffsetHours + (CaiDstByRule(rule, utc) ? 1 : 0)) * 3600;
  }
//+------------------------------------------------------------------+
//| Server-minus-UTC offset in seconds. Returns false when it cannot  |
//| be determined (caller must then block entries).                   |
//+------------------------------------------------------------------+
bool CaiServerUtcOffset(const ENUM_CAI_SERVER_TIME_MODE mode, const int stdOffsetHours,
                        const ENUM_CAI_DST_RULE rule, const datetime serverNow, int &offsetSec)
  {
   offsetSec = 0;
   if(mode == CAI_SERVER_TIME_MANUAL)
     {
      datetime utc = CaiServerToUtcManual(serverNow, stdOffsetHours, rule);
      offsetSec = (int)(serverNow - utc);
      return true;
     }
   if(MQLInfoInteger(MQL_TESTER))
      return false;                           // TimeGMT() is simulated in the tester: AUTO is meaningless
   long diff = (long)TimeTradeServer() - (long)TimeGMT();
   long rounded = (long)MathRound((double)diff / 900.0) * 900;      // offsets are multiples of 15 minutes
   if(MathAbs(diff - rounded) > 120 || MathAbs(rounded) > 14 * 3600)
      return false;                           // local clock is off: do not guess
   offsetSec = (int)rounded;
   return true;
  }

//==================== end Sessions.mqh ====================
//==================== begin Risk.mqh ====================
//+------------------------------------------------------------------+
//| Risk.mqh - pure, broker-aware calculations (no trading calls).    |
//| Mirrors refmodel/risk.py function-for-function.                   |
//+------------------------------------------------------------------+

#define CAI_EPS 1e-9
#define CAI_ROUND_NEAREST 0
#define CAI_ROUND_DOWN    1
#define CAI_ROUND_UP      2

//+------------------------------------------------------------------+
double CaiRoundToTick(const double price, const double tick, const int mode = CAI_ROUND_NEAREST)
  {
   if(tick <= 0.0)
      return price;
   double q = price / tick;
   double n;
   if(mode == CAI_ROUND_DOWN)
      n = MathFloor(q + CAI_EPS);
   else if(mode == CAI_ROUND_UP)
      n = MathCeil(q - CAI_EPS);
   else
      n = MathFloor(q + 0.5);
   return NormalizeDouble(n * tick, 8);
  }
//+------------------------------------------------------------------+
//| Floor to step, cap at max. Below broker minimum -> 0.             |
//| Risk is never rounded UP.                                         |
//+------------------------------------------------------------------+
double CaiNormalizeVolume(const double vol, const double vmin, const double vmax, const double step)
  {
   if(!(vol > 0.0) || !(step > 0.0) || !(vmin > 0.0) || vmax < vmin)
      return 0.0;
   double v = MathFloor(vol / step + CAI_EPS) * step;
   double cap = MathFloor(vmax / step + CAI_EPS) * step;
   if(v > cap)
      v = cap;
   if(v + CAI_EPS < vmin)
      return 0.0;
   return NormalizeDouble(v, 8);
  }
//+------------------------------------------------------------------+
//| isBuy: SL = entry - slMult*ATR, TP = entry + tpMult*ATR           |
//+------------------------------------------------------------------+
void CaiInitialStops(const bool isBuy, const double entry, const double atr, const double tick,
                     const double slMult, const double tpMult, double &sl, double &tp)
  {
   if(isBuy)
     {
      sl = CaiRoundToTick(entry - slMult * atr, tick);
      tp = CaiRoundToTick(entry + tpMult * atr, tick);
     }
   else
     {
      sl = CaiRoundToTick(entry + slMult * atr, tick);
      tp = CaiRoundToTick(entry - tpMult * atr, tick);
     }
  }
//+------------------------------------------------------------------+
//| Broker StopLevel rule for market orders. minDist is a PRICE       |
//| distance (stops level in points * point).                         |
//+------------------------------------------------------------------+
bool CaiStopsValid(const bool isBuy, const double bid, const double ask,
                   const double sl, const double tp, const double minDist)
  {
   if(sl <= 0.0 || tp <= 0.0)
      return false;
   if(isBuy)
      return (bid - sl >= minDist - CAI_EPS && tp - bid >= minDist - CAI_EPS);
   return (sl - ask >= minDist - CAI_EPS && ask - tp >= minDist - CAI_EPS);
  }
//+------------------------------------------------------------------+
//| Break-even + trailing. Returns the new SL, or 0.0 for "no change".|
//| price = Bid for BUY, Ask for SELL.                                |
//|  gain >= beTrigger*ATR   -> SL to entry (+ buffer ticks, default 0)|
//|  gain >= trailStart*ATR  -> SL follows price at trailDist*ATR     |
//| BUY SL never decreases, SELL SL never increases.                  |
//+------------------------------------------------------------------+
double CaiTrailSL(const bool isBuy, const double entry, const double curSl, const double price,
                  const double atr, const double tick,
                  const double beTrigger, const double trailStart, const double trailDist,
                  const int beBufferTicks, const double minDist, const double freezeDist)
  {
   if(atr <= 0.0 || tick <= 0.0)
      return 0.0;
   double sign = isBuy ? 1.0 : -1.0;
   double gain = (price - entry) * sign;
   bool   have = false;
   double cand = 0.0;
   if(gain >= beTrigger * atr - CAI_EPS)
     {
      cand = entry + sign * beBufferTicks * tick;
      have = true;
     }
   if(gain >= trailStart * atr - CAI_EPS)
     {
      double t = price - sign * trailDist * atr;
      if(!have)
         cand = t;
      else
         cand = isBuy ? MathMax(cand, t) : MathMin(cand, t);
      have = true;
     }
   if(!have)
      return 0.0;
   if(curSl > 0.0 && freezeDist > 0.0 && MathAbs(price - curSl) <= freezeDist + CAI_EPS)
      return 0.0;                              // inside freeze level: broker would reject
   double limit = price - sign * minDist;      // closest SL the broker accepts
   if(isBuy)
     {
      cand = CaiRoundToTick(MathMin(cand, limit), tick, CAI_ROUND_DOWN);
      if(curSl <= 0.0 || cand >= curSl + tick - CAI_EPS)
         return cand;
      return 0.0;
     }
   cand = CaiRoundToTick(MathMax(cand, limit), tick, CAI_ROUND_UP);
   if(curSl <= 0.0 || cand <= curSl - tick + CAI_EPS)
      return cand;
   return 0.0;
  }
//+------------------------------------------------------------------+
//| Daily latch decision. Returns 0 none, 1 profit target, 2 loss.    |
//+------------------------------------------------------------------+
int CaiDailyBreach(const double realized, const double floating,
                   const double profitTarget, const double lossLimit)
  {
   double total = realized + floating;
   if(profitTarget > 0.0 && total >= profitTarget - CAI_EPS)
      return 1;
   if(lossLimit > 0.0 && total <= -lossLimit + CAI_EPS)
      return 2;
   return 0;
  }
//+------------------------------------------------------------------+
int CaiDayId(const datetime serverTime)        // broker day as yyyymmdd
  {
   MqlDateTime s;
   TimeToStruct(serverTime, s);
   return s.year * 10000 + s.mon * 100 + s.day;
  }

//==================== end Risk.mqh ====================
//==================== begin Audit.mqh ====================
//+------------------------------------------------------------------+
//| Audit.mqh - append-only CSV audit log (MQL5/Files).               |
//| Never receives the bridge token; text fields are sanitised.       |
//+------------------------------------------------------------------+

string g_caiAuditFile = "";
bool   g_caiAuditOn   = false;

//+------------------------------------------------------------------+
string CaiClean(const string text, const int maxLen = 300)
  {
   string s = text;
   StringReplace(s, ",", ";");
   StringReplace(s, "\"", "'");
   StringReplace(s, "\r", " ");
   StringReplace(s, "\n", " ");
   if(StringLen(s) > maxLen)
      s = StringSubstr(s, 0, maxLen);
   return s;
  }
//+------------------------------------------------------------------+
string CaiUtcStamp(const datetime utc)
  {
   MqlDateTime s;
   TimeToStruct(utc, s);
   return StringFormat("%04d-%02d-%02dT%02d:%02d:%02dZ", s.year, s.mon, s.day, s.hour, s.min, s.sec);
  }
//+------------------------------------------------------------------+
void CaiAuditInit(const bool enabled, const string symbol, const long magic)
  {
   g_caiAuditOn = enabled;
   g_caiAuditFile = StringFormat("ClaudeEA_audit_%s_%I64d.csv", symbol, magic);
   if(!g_caiAuditOn)
      return;
   int h = FileOpen(g_caiAuditFile, FILE_READ | FILE_WRITE | FILE_TXT | FILE_ANSI | FILE_SHARE_READ);
   if(h == INVALID_HANDLE)
     {
      PrintFormat("ClaudeEA: cannot open audit file %s (error %d); audit disabled", g_caiAuditFile, GetLastError());
      g_caiAuditOn = false;
      return;
     }
   if(FileSize(h) == 0)
      FileWriteString(h, "ts_utc,event,symbol,bar_time,request_id,signal,confidence,decision,reason,"
                         "equity,daily_pnl,spread_points,volume,sl,tp,ticket,retcode,latency_ms\r\n");
   FileClose(h);
  }
//+------------------------------------------------------------------+
void CaiAudit(const datetime utcNow, const string event, const string symbol, const datetime barTime,
              const string requestId, const string signal, const double confidence,
              const string decision, const string reason,
              const double equity, const double dailyPnl, const double spreadPoints,
              const double volume, const double sl, const double tp,
              const ulong ticket, const uint retcode, const long latencyMs)
  {
   string line = StringFormat("%s,%s,%s,%I64d,%s,%s,%.1f,%s,%s,%.2f,%.2f,%.1f,%.2f,%.5f,%.5f,%I64u,%u,%I64d",
                              CaiUtcStamp(utcNow), CaiClean(event, 32), CaiClean(symbol, 32), (long)barTime,
                              CaiClean(requestId, 96), CaiClean(signal, 8), confidence,
                              CaiClean(decision, 32), CaiClean(reason),
                              equity, dailyPnl, spreadPoints, volume, sl, tp, ticket, retcode, latencyMs);
   PrintFormat("ClaudeEA: %s", line);
   if(!g_caiAuditOn)
      return;
   int h = FileOpen(g_caiAuditFile, FILE_READ | FILE_WRITE | FILE_TXT | FILE_ANSI | FILE_SHARE_READ);
   if(h == INVALID_HANDLE)
      return;
   FileSeek(h, 0, SEEK_END);
   FileWriteString(h, line + "\r\n");
   FileClose(h);
  }

//==================== end Audit.mqh ====================
//==================== begin Bridge.mqh ====================
//+------------------------------------------------------------------+
//| Bridge.mqh - client of the local Python bridge.                   |
//| One short WebRequest per call; no retry loops, no Sleep().        |
//| Any transport, status, schema or identity mismatch => HOLD.       |
//+------------------------------------------------------------------+

//==================== begin Json.mqh ====================
//+------------------------------------------------------------------+
//| Json.mqh - strict parser for ONE FLAT JSON object.                |
//| Values: string | number | true | false | null. Anything else      |
//| (nesting, arrays, duplicate keys, trailing text, oversize input)  |
//| fails the parse, and the caller treats that as HOLD.              |
//+------------------------------------------------------------------+

#define CJ_MAX_LEN   4096
#define CJ_MAX_KEYS  32
#define CJ_T_STRING  0
#define CJ_T_NUMBER  1
#define CJ_T_BOOL    2
#define CJ_T_NULL    3

class CFlatJson
  {
private:
   string            m_src;
   int               m_len;
   int               m_pos;
   string            m_keys[];
   string            m_vals[];
   int               m_types[];
   int               m_count;

   ushort            Peek() { return (m_pos < m_len) ? StringGetCharacter(m_src, m_pos) : 0; }
   void              SkipWs()
     {
      while(m_pos < m_len)
        {
         ushort c = StringGetCharacter(m_src, m_pos);
         if(c == ' ' || c == '\t' || c == '\n' || c == '\r')
            m_pos++;
         else
            break;
        }
     }
   static bool       IsDigit(const ushort c) { return (c >= '0' && c <= '9'); }
   static int        HexVal(const ushort c)
     {
      if(c >= '0' && c <= '9') return (int)(c - '0');
      if(c >= 'a' && c <= 'f') return (int)(c - 'a') + 10;
      if(c >= 'A' && c <= 'F') return (int)(c - 'A') + 10;
      return -1;
     }
   bool              ParseString(string &out);
   bool              ParseNumber(string &out);
   bool              ParseLiteral(const string word);
   int               Find(const string key) const;

public:
                     CFlatJson() { m_len = 0; m_pos = 0; m_count = 0; }
   bool              Parse(const string text);
   int               Count() const { return m_count; }
   bool              Has(const string key) const { return Find(key) >= 0; }
   bool              GetString(const string key, string &out) const;
   bool              GetNumber(const string key, double &out) const;
  };

//+------------------------------------------------------------------+
bool CFlatJson::ParseString(string &out)
  {
   out = "";
   if(Peek() != '"')
      return false;
   m_pos++;
   while(m_pos < m_len)
     {
      ushort c = StringGetCharacter(m_src, m_pos);
      m_pos++;
      if(c == '"')
         return true;
      if(c < 0x20)
         return false;                       // raw control characters are illegal in JSON strings
      if(c != '\\')
        {
         out += ShortToString(c);
         continue;
        }
      if(m_pos >= m_len)
         return false;
      ushort e = StringGetCharacter(m_src, m_pos);
      m_pos++;
      switch(e)
        {
         case '"':  out += "\""; break;
         case '\\': out += "\\"; break;
         case '/':  out += "/";  break;
         case 'b':  out += " ";  break;
         case 'f':  out += " ";  break;
         case 'n':  out += " ";  break;
         case 'r':  out += " ";  break;
         case 't':  out += " ";  break;
         case 'u':
           {
            if(m_pos + 4 > m_len)
               return false;
            int code = 0;
            for(int i = 0; i < 4; i++)
              {
               int h = HexVal(StringGetCharacter(m_src, m_pos + i));
               if(h < 0)
                  return false;
               code = code * 16 + h;
              }
            m_pos += 4;
            out += (code < 0x20) ? " " : ShortToString((ushort)code);
            break;
           }
         default:
            return false;
        }
     }
   return false;                             // unterminated
  }
//+------------------------------------------------------------------+
//| JSON grammar: -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?      |
//+------------------------------------------------------------------+
bool CFlatJson::ParseNumber(string &out)
  {
   int start = m_pos;
   if(Peek() == '-')
      m_pos++;
   if(!IsDigit(Peek()))
      return false;
   if(Peek() == '0')
      m_pos++;
   else
      while(IsDigit(Peek()))
         m_pos++;
   if(Peek() == '.')
     {
      m_pos++;
      if(!IsDigit(Peek()))
         return false;
      while(IsDigit(Peek()))
         m_pos++;
     }
   if(Peek() == 'e' || Peek() == 'E')
     {
      m_pos++;
      if(Peek() == '+' || Peek() == '-')
         m_pos++;
      if(!IsDigit(Peek()))
         return false;
      while(IsDigit(Peek()))
         m_pos++;
     }
   if(m_pos - start > 32)
      return false;
   out = StringSubstr(m_src, start, m_pos - start);
   return true;
  }
//+------------------------------------------------------------------+
bool CFlatJson::ParseLiteral(const string word)
  {
   int n = StringLen(word);
   if(m_pos + n > m_len || StringSubstr(m_src, m_pos, n) != word)
      return false;
   m_pos += n;
   return true;
  }
//+------------------------------------------------------------------+
int CFlatJson::Find(const string key) const
  {
   for(int i = 0; i < m_count; i++)
      if(m_keys[i] == key)
         return i;
   return -1;
  }
//+------------------------------------------------------------------+
bool CFlatJson::Parse(const string text)
  {
   m_src = text;
   m_len = StringLen(text);
   m_pos = 0;
   m_count = 0;
   ArrayResize(m_keys, 0);
   ArrayResize(m_vals, 0);
   ArrayResize(m_types, 0);
   if(m_len < 2 || m_len > CJ_MAX_LEN)
      return false;
   SkipWs();
   if(Peek() != '{')
      return false;
   m_pos++;
   SkipWs();
   if(Peek() == '}')
      m_pos++;
   else
     {
      while(true)
        {
         SkipWs();
         string key;
         if(!ParseString(key) || key == "" || Find(key) >= 0 || m_count >= CJ_MAX_KEYS)
           { m_count = 0; return false; }
         SkipWs();
         if(Peek() != ':')
           { m_count = 0; return false; }
         m_pos++;
         SkipWs();
         string val = "";
         int    type = -1;
         ushort c = Peek();
         if(c == '"')
           { if(ParseString(val)) type = CJ_T_STRING; }
         else if(c == '-' || IsDigit(c))
           { if(ParseNumber(val)) type = CJ_T_NUMBER; }
         else if(c == 't')
           { if(ParseLiteral("true"))  { val = "true";  type = CJ_T_BOOL; } }
         else if(c == 'f')
           { if(ParseLiteral("false")) { val = "false"; type = CJ_T_BOOL; } }
         else if(c == 'n')
           { if(ParseLiteral("null"))  { val = "";      type = CJ_T_NULL; } }
         if(type < 0)                         // includes '{' and '[' : nesting is not accepted
           { m_count = 0; return false; }
         ArrayResize(m_keys, m_count + 1);
         ArrayResize(m_vals, m_count + 1);
         ArrayResize(m_types, m_count + 1);
         m_keys[m_count] = key;
         m_vals[m_count] = val;
         m_types[m_count] = type;
         m_count++;
         SkipWs();
         if(Peek() == ',')
           { m_pos++; continue; }
         if(Peek() == '}')
           { m_pos++; break; }
         m_count = 0;
         return false;
        }
     }
   SkipWs();
   if(m_pos != m_len)                         // trailing garbage
     { m_count = 0; return false; }
   return true;
  }
//+------------------------------------------------------------------+
bool CFlatJson::GetString(const string key, string &out) const
  {
   int i = Find(key);
   if(i < 0 || m_types[i] != CJ_T_STRING)
      return false;
   out = m_vals[i];
   return true;
  }
//+------------------------------------------------------------------+
bool CFlatJson::GetNumber(const string key, double &out) const
  {
   int i = Find(key);
   if(i < 0 || m_types[i] != CJ_T_NUMBER)
      return false;
   double v = StringToDouble(m_vals[i]);
   if(!MathIsValidNumber(v))
      return false;
   out = v;
   return true;
  }

//==================== end Json.mqh ====================

#define CAI_SIG_HOLD 0
#define CAI_SIG_BUY  1
#define CAI_SIG_SELL 2

#define CAI_BRIDGE_ERROR   0     // treat as HOLD for this bar
#define CAI_BRIDGE_PENDING 1
#define CAI_BRIDGE_FINAL   2

struct CaiSignal
  {
   int               side;          // CAI_SIG_*
   double            confidence;    // 0..100, uncalibrated self-report
   string            reason;        // logged only, never interpreted
   string            source;
   datetime          barTime;
  };

string g_caiBridgeToken = "";       // loaded from file, never printed

//+------------------------------------------------------------------+
string CaiSideName(const int side)
  {
   if(side == CAI_SIG_BUY)  return "BUY";
   if(side == CAI_SIG_SELL) return "SELL";
   return "HOLD";
  }
//+------------------------------------------------------------------+
void CaiHold(CaiSignal &sig, const string reason)
  {
   sig.side = CAI_SIG_HOLD;
   sig.confidence = 0.0;
   sig.reason = reason;
   sig.source = "ea";
   sig.barTime = 0;
  }
//+------------------------------------------------------------------+
//| Only loopback URLs are accepted.                                  |
//+------------------------------------------------------------------+
bool CaiBridgeUrlIsLocal(const string url)
  {
   return (StringFind(url, "http://127.0.0.1:") == 0 || StringFind(url, "http://localhost:") == 0);
  }
//+------------------------------------------------------------------+
//| Token lives in MQL5/Files/<file>, not in inputs/.set files.       |
//+------------------------------------------------------------------+
bool CaiBridgeLoadToken(const string fileName)
  {
   g_caiBridgeToken = "";
   int h = FileOpen(fileName, FILE_READ | FILE_TXT | FILE_ANSI);
   if(h == INVALID_HANDLE)
      return false;
   string t = FileReadString(h);
   FileClose(h);
   StringTrimLeft(t);
   StringTrimRight(t);
   if(StringLen(t) < 32 || StringLen(t) > 256)
      return false;
   for(int i = 0; i < StringLen(t); i++)
     {
      ushort c = StringGetCharacter(t, i);
      if(c <= 0x20 || c >= 0x7F)
         return false;
     }
   g_caiBridgeToken = t;
   return true;
  }
//+------------------------------------------------------------------+
//| Symbol characters allowed in request ids / JSON.                  |
//+------------------------------------------------------------------+
bool CaiSymbolCharsOk(const string symbol)
  {
   int n = StringLen(symbol);
   if(n < 1 || n > 30)
      return false;
   for(int i = 0; i < n; i++)
     {
      ushort c = StringGetCharacter(symbol, i);
      bool ok = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
                c == '.' || c == '_' || c == '#' || c == '-';
      if(!ok)
         return false;
     }
   return true;
  }
//+------------------------------------------------------------------+
string CaiRequestId(const string symbol, const datetime barTime, const long magic)
  {
   return StringFormat("%s-M5-%I64d-%I64d", symbol, (long)barTime, magic);
  }
//+------------------------------------------------------------------+
//| Build the request body from 20 CLOSED bars (rates[0] = oldest).   |
//| Returns false if the series is incomplete or malformed.           |
//+------------------------------------------------------------------+
bool CaiBuildRequest(const string symbol, const string requestId, const MqlRates &rates[],
                     const double atr, const double spreadPoints, const int serverUtcOffsetSec,
                     string &body)
  {
   body = "";
   if(ArraySize(rates) != 20 || !(atr > 0.0) || !MathIsValidNumber(atr) || spreadPoints < 0.0)
      return false;
   int    digits   = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
   double point    = SymbolInfoDouble(symbol, SYMBOL_POINT);
   double tickSize = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
   double contract = SymbolInfoDouble(symbol, SYMBOL_TRADE_CONTRACT_SIZE);
   if(point <= 0.0 || tickSize <= 0.0 || contract <= 0.0)
      return false;
   string candles = "";
   for(int i = 0; i < 20; i++)
     {
      double o = rates[i].open, h = rates[i].high, l = rates[i].low, c = rates[i].close;
      if(!(l > 0.0) || h < MathMax(o, c) || l > MathMin(o, c) || h < l)
         return false;                                       // malformed OHLC
      if(i > 0)
        {
         long gap = (long)rates[i].time - (long)rates[i - 1].time;
         if(gap <= 0 || gap % 300 != 0)
            return false;                                    // order / alignment
        }
      if((long)rates[i].time % 300 != 0)
         return false;
      if(i > 0)
         candles += ",";
      candles += StringFormat("{\"time\":%I64d,\"open\":%s,\"high\":%s,\"low\":%s,\"close\":%s}",
                              (long)rates[i].time,
                              DoubleToString(o, digits), DoubleToString(h, digits),
                              DoubleToString(l, digits), DoubleToString(c, digits));
     }
   body = StringFormat("{\"request_id\":\"%s\",\"symbol\":\"%s\",\"timeframe\":\"M5\","
                       "\"server_utc_offset_sec\":%d,\"spread_points\":%s,\"atr\":%s,\"digits\":%d,"
                       "\"point\":%s,\"tick_size\":%s,\"contract_size\":%s,\"candles\":[%s]}",
                       requestId, symbol, serverUtcOffsetSec,
                       DoubleToString(spreadPoints, 1), DoubleToString(atr, 8), digits,
                       DoubleToString(point, 8), DoubleToString(tickSize, 8),
                       DoubleToString(contract, 4), candles);
   return true;
  }
//+------------------------------------------------------------------+
//| One HTTP exchange. Returns HTTP status, or -1 on transport error. |
//+------------------------------------------------------------------+
int CaiHttp(const string method, const string url, const string body, const int timeoutMs, string &response)
  {
   response = "";
   if(g_caiBridgeToken == "" || !CaiBridgeUrlIsLocal(url))
      return -1;
   string headers = "Content-Type: application/json\r\nX-Bridge-Token: " + g_caiBridgeToken + "\r\n";
   char data[];
   char result[];
   string resultHeaders = "";
   if(body != "")
     {
      int n = StringToCharArray(body, data, 0, WHOLE_ARRAY, CP_UTF8);
      if(n > 0)
         ArrayResize(data, n - 1);                           // drop the terminating zero
     }
   else
      ArrayResize(data, 0);
   ResetLastError();
   int status = WebRequest(method, url, headers, timeoutMs, data, result, resultHeaders);
   if(status == -1)
      return -1;                                             // 4014 = URL not in the allowed list
   if(ArraySize(result) > 8192)
      return -1;
   response = CharArrayToString(result, 0, WHOLE_ARRAY, CP_UTF8);
   return status;
  }
//+------------------------------------------------------------------+
//| Validate a bridge response. Returns CAI_BRIDGE_*; sig is HOLD     |
//| unless the response is FINAL, well-formed and for OUR request.    |
//+------------------------------------------------------------------+
int CaiParseResponse(const int httpStatus, const string response, const string requestId,
                     const datetime barTime, CaiSignal &sig)
  {
   CaiHold(sig, "bridge unavailable");
   if(httpStatus != 200 && httpStatus != 202)
     {
      sig.reason = StringFormat("bridge http %d", httpStatus);
      return CAI_BRIDGE_ERROR;
     }
   CFlatJson json;
   if(!json.Parse(response))
     {
      sig.reason = "bridge response is not valid flat JSON";
      return CAI_BRIDGE_ERROR;
     }
   string rid = "", status = "", signal = "", reason = "", source = "";
   double conf = -1.0, bt = -1.0;
   if(!json.GetString("request_id", rid) || !json.GetString("status", status) ||
      !json.GetString("signal", signal) || !json.GetNumber("confidence", conf) ||
      !json.GetString("reason", reason) || !json.GetNumber("bar_time", bt) ||
      !json.GetString("source", source) || json.Count() != 7)
     {
      sig.reason = "bridge response schema mismatch";
      return CAI_BRIDGE_ERROR;
     }
   if(rid != requestId)
     {
      sig.reason = "bridge response is for another request";
      return CAI_BRIDGE_ERROR;
     }
   if(status == "pending")
     {
      sig.reason = "pending";
      return CAI_BRIDGE_PENDING;
     }
   if(status != "final" || conf < 0.0 || conf > 100.0)
     {
      sig.reason = "bridge response invalid status/confidence";
      return CAI_BRIDGE_ERROR;
     }
   sig.reason = reason;
   sig.source = source;
   sig.barTime = (datetime)(long)bt;
   if(signal == "HOLD")
      return CAI_BRIDGE_FINAL;
   if(signal != "BUY" && signal != "SELL")
     {
      CaiHold(sig, "bridge response has unknown signal");
      return CAI_BRIDGE_ERROR;
     }
   if((long)bt != (long)barTime)
     {
      CaiHold(sig, "bridge signal is for another bar");
      return CAI_BRIDGE_ERROR;
     }
   sig.side = (signal == "BUY") ? CAI_SIG_BUY : CAI_SIG_SELL;
   sig.confidence = conf;
   return CAI_BRIDGE_FINAL;
  }

//==================== end Bridge.mqh ====================
//==================== begin Replay.mqh ====================
//+------------------------------------------------------------------+
//| Replay.mqh - historical AI replay for the Strategy Tester.        |
//| WebRequest is not available in the tester, so signals come from a |
//| CSV produced offline by `python -m replay.generate`:              |
//|   bar_time,signal,confidence,source                               |
//| bar_time = open time (broker server clock) of the CLOSED bar the  |
//| signal was computed from. The EA reads the row only after that    |
//| bar has closed, so no future information is available to it.      |
//+------------------------------------------------------------------+


long   g_caiReplayTime[];
int    g_caiReplaySide[];
double g_caiReplayConf[];
int    g_caiReplayCount = 0;

//+------------------------------------------------------------------+
//| Loads the file from the terminal COMMON folder. Rows must be      |
//| strictly ascending by time; any malformed row aborts the load.    |
//+------------------------------------------------------------------+
bool CaiReplayLoad(const string fileName)
  {
   g_caiReplayCount = 0;
   ArrayResize(g_caiReplayTime, 0);
   ArrayResize(g_caiReplaySide, 0);
   ArrayResize(g_caiReplayConf, 0);
   int h = FileOpen(fileName, FILE_READ | FILE_TXT | FILE_ANSI | FILE_COMMON);
   if(h == INVALID_HANDLE)
      return false;
   bool first = true;
   bool ok = true;
   long prev = 0;
   while(!FileIsEnding(h))
     {
      string line = FileReadString(h);
      StringTrimLeft(line);
      StringTrimRight(line);
      if(line == "" || StringGetCharacter(line, 0) == '#')
         continue;
      if(first)
        {
         first = false;
         if(StringFind(line, "bar_time") == 0)
            continue;                                         // header
        }
      string parts[];
      if(StringSplit(line, ',', parts) < 3)
        { ok = false; break; }
      long   t = StringToInteger(parts[0]);
      double c = StringToDouble(parts[2]);
      int side = CAI_SIG_HOLD;
      if(parts[1] == "BUY")       side = CAI_SIG_BUY;
      else if(parts[1] == "SELL") side = CAI_SIG_SELL;
      else if(parts[1] == "HOLD") side = CAI_SIG_HOLD;
      else { ok = false; break; }
      if(t <= prev || t % 300 != 0 || c < 0.0 || c > 100.0 || !MathIsValidNumber(c))
        { ok = false; break; }
      prev = t;
      int n = g_caiReplayCount;
      if(n >= ArraySize(g_caiReplayTime))
        {
         ArrayResize(g_caiReplayTime, n + 4096);
         ArrayResize(g_caiReplaySide, n + 4096);
         ArrayResize(g_caiReplayConf, n + 4096);
        }
      g_caiReplayTime[n] = t;
      g_caiReplaySide[n] = side;
      g_caiReplayConf[n] = c;
      g_caiReplayCount++;
     }
   FileClose(h);
   if(!ok)
      g_caiReplayCount = 0;
   return (ok && g_caiReplayCount > 0);
  }
//+------------------------------------------------------------------+
//| Exact-match lookup for a closed bar. Missing row => HOLD.         |
//+------------------------------------------------------------------+
void CaiReplayLookup(const datetime closedBarTime, CaiSignal &sig)
  {
   CaiHold(sig, "replay: no signal for this bar");
   sig.source = "replay";
   long key = (long)closedBarTime;
   int lo = 0, hi = g_caiReplayCount - 1;
   while(lo <= hi)
     {
      int mid = (lo + hi) / 2;
      if(g_caiReplayTime[mid] == key)
        {
         sig.side = g_caiReplaySide[mid];
         sig.confidence = g_caiReplayConf[mid];
         sig.reason = "replay";
         sig.barTime = closedBarTime;
         return;
        }
      if(g_caiReplayTime[mid] < key)
         lo = mid + 1;
      else
         hi = mid - 1;
     }
  }

//==================== end Replay.mqh ====================
//==================== begin Execution.mqh ====================
//+------------------------------------------------------------------+
//| Execution.mqh - position ownership, P/L accounting and CTrade     |
//| calls. Every function acts ONLY on positions/deals with this EA's |
//| magic number on this symbol; nothing else is ever touched.        |
//+------------------------------------------------------------------+

#include <Trade\Trade.mqh>

CTrade g_caiTrade;
string g_caiSymbol = "";
long   g_caiMagic  = 0;

//+------------------------------------------------------------------+
void CaiExecInit(const string symbol, const long magic, const int maxSlippagePoints)
  {
   g_caiSymbol = symbol;
   g_caiMagic  = magic;
   g_caiTrade.SetExpertMagicNumber(magic);
   g_caiTrade.SetDeviationInPoints((ulong)MathMax(0, maxSlippagePoints));
   g_caiTrade.SetTypeFillingBySymbol(symbol);
   g_caiTrade.SetAsyncMode(false);            // synchronous: we read the retcode of each request
   g_caiTrade.LogLevel(LOG_LEVEL_ERRORS);
  }
//+------------------------------------------------------------------+
string CaiGvName(const string key)
  {
   return StringFormat("CAI_%I64d_%s_%s", g_caiMagic, g_caiSymbol, key);
  }
//+------------------------------------------------------------------+
bool CaiGvGet(const string key, double &value)
  {
   string name = CaiGvName(key);
   if(!GlobalVariableCheck(name))
      return false;
   return GlobalVariableGet(name, value);
  }
//+------------------------------------------------------------------+
//| Persist a value and flush it to disk. Returns false on failure so |
//| callers can refuse to trade when state cannot be saved.           |
//+------------------------------------------------------------------+
bool CaiGvSet(const string key, const double value)
  {
   if(GlobalVariableSet(CaiGvName(key), value) == 0)
      return false;
   GlobalVariablesFlush();
   return true;
  }
//+------------------------------------------------------------------+
bool CaiIsNetting()
  {
   return ((ENUM_ACCOUNT_MARGIN_MODE)AccountInfoInteger(ACCOUNT_MARGIN_MODE) != ACCOUNT_MARGIN_MODE_RETAIL_HEDGING);
  }
//+------------------------------------------------------------------+
bool CaiTradePermitted()
  {
   if(!MQLInfoInteger(MQL_TESTER) && !TerminalInfoInteger(TERMINAL_CONNECTED))
      return false;                                   // connection lost: fail closed
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED))  return false;
   if(!MQLInfoInteger(MQL_TRADE_ALLOWED))            return false;
   if(!AccountInfoInteger(ACCOUNT_TRADE_ALLOWED))    return false;
   if(!AccountInfoInteger(ACCOUNT_TRADE_EXPERT))     return false;
   if((ENUM_SYMBOL_TRADE_MODE)SymbolInfoInteger(g_caiSymbol, SYMBOL_TRADE_MODE) != SYMBOL_TRADE_MODE_FULL)
      return false;
   return true;
  }
//+------------------------------------------------------------------+
//| Collect tickets of managed positions (this symbol + this magic).  |
//+------------------------------------------------------------------+
int CaiManagedTickets(ulong &tickets[])
  {
   ArrayResize(tickets, 0);
   int total = PositionsTotal();
   for(int i = 0; i < total; i++)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0)
         continue;
      if(PositionGetString(POSITION_SYMBOL) != g_caiSymbol)
         continue;
      if(PositionGetInteger(POSITION_MAGIC) != g_caiMagic)
         continue;
      int n = ArraySize(tickets);
      ArrayResize(tickets, n + 1);
      tickets[n] = ticket;
     }
   return ArraySize(tickets);
  }
//+------------------------------------------------------------------+
//| On netting accounts a position on this symbol with another magic  |
//| cannot be separated from ours: block entries entirely.            |
//+------------------------------------------------------------------+
bool CaiForeignPositionOnNetting()
  {
   if(!CaiIsNetting())
      return false;
   if(!PositionSelect(g_caiSymbol))
      return false;
   return (PositionGetInteger(POSITION_MAGIC) != g_caiMagic);
  }
//+------------------------------------------------------------------+
//| Floating P/L of managed positions (profit + swap).                |
//+------------------------------------------------------------------+
double CaiManagedFloating()
  {
   double sum = 0.0;
   int total = PositionsTotal();
   for(int i = 0; i < total; i++)
     {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0)
         continue;
      if(PositionGetString(POSITION_SYMBOL) != g_caiSymbol || PositionGetInteger(POSITION_MAGIC) != g_caiMagic)
         continue;
      sum += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
     }
   return sum;
  }
//+------------------------------------------------------------------+
//| Realized result of managed deals since dayStart, including        |
//| commission, fee and swap; also counts today's entries.            |
//| Recomputed from broker history, so it survives EA restarts.       |
//+------------------------------------------------------------------+
bool CaiDayHistory(const datetime dayStart, const datetime now, double &realized, int &entries)
  {
   realized = 0.0;
   entries = 0;
   if(!HistorySelect(dayStart, now + 86400))
      return false;
   int total = HistoryDealsTotal();
   for(int i = 0; i < total; i++)
     {
      ulong deal = HistoryDealGetTicket(i);
      if(deal == 0)
         continue;
      if(HistoryDealGetString(deal, DEAL_SYMBOL) != g_caiSymbol)
         continue;
      if(HistoryDealGetInteger(deal, DEAL_MAGIC) != g_caiMagic)
         continue;
      ENUM_DEAL_TYPE type = (ENUM_DEAL_TYPE)HistoryDealGetInteger(deal, DEAL_TYPE);
      if(type != DEAL_TYPE_BUY && type != DEAL_TYPE_SELL)
         continue;
      realized += HistoryDealGetDouble(deal, DEAL_PROFIT) + HistoryDealGetDouble(deal, DEAL_SWAP) +
                  HistoryDealGetDouble(deal, DEAL_COMMISSION) + HistoryDealGetDouble(deal, DEAL_FEE);
      if((ENUM_DEAL_ENTRY)HistoryDealGetInteger(deal, DEAL_ENTRY) == DEAL_ENTRY_IN)
         entries++;
     }
   return true;
  }
//+------------------------------------------------------------------+
//| Volume for a fixed money risk at the given stop distance.         |
//| Uses OrderCalcProfit so contract/currency conversion is the       |
//| broker's own. Returns 0 if it cannot be computed.                 |
//+------------------------------------------------------------------+
double CaiVolumeForRisk(const bool isBuy, const double entry, const double sl, const double riskMoney)
  {
   if(riskMoney <= 0.0)
      return 0.0;
   double pl = 0.0;
   if(!OrderCalcProfit(isBuy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL, g_caiSymbol, 1.0, entry, sl, pl))
      return 0.0;
   double lossPerLot = -pl;
   if(!(lossPerLot > 0.0) || !MathIsValidNumber(lossPerLot))
      return 0.0;
   return riskMoney / lossPerLot;
  }
//+------------------------------------------------------------------+
bool CaiMarginOk(const bool isBuy, const double volume, const double price, const double maxUsePct)
  {
   double margin = 0.0;
   if(!OrderCalcMargin(isBuy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL, g_caiSymbol, volume, price, margin))
      return false;
   double freeMargin = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
   if(!(margin > 0.0) || !(freeMargin > 0.0))
      return false;
   return (margin <= freeMargin * maxUsePct / 100.0);
  }
//+------------------------------------------------------------------+
//| Send ONE market order. Never retried by the EA.                   |
//+------------------------------------------------------------------+
bool CaiOpen(const bool isBuy, const double volume, const double sl, const double tp,
             const string comment, uint &retcode, ulong &order)
  {
   bool sent = isBuy ? g_caiTrade.Buy(volume, g_caiSymbol, 0.0, sl, tp, comment)
                     : g_caiTrade.Sell(volume, g_caiSymbol, 0.0, sl, tp, comment);
   retcode = g_caiTrade.ResultRetcode();
   order   = g_caiTrade.ResultOrder();
   return (sent && (retcode == TRADE_RETCODE_DONE || retcode == TRADE_RETCODE_DONE_PARTIAL));
  }
//+------------------------------------------------------------------+
//| Close all managed positions and VERIFY none remains.              |
//| Closing a specific ticket is idempotent, so the caller may call   |
//| this again on a later tick if it returns false.                   |
//+------------------------------------------------------------------+
bool CaiCloseManaged(uint &lastRetcode)
  {
   lastRetcode = 0;
   ulong tickets[];
   int n = CaiManagedTickets(tickets);
   for(int i = 0; i < n; i++)
     {
      g_caiTrade.PositionClose(tickets[i]);
      lastRetcode = g_caiTrade.ResultRetcode();
     }
   ulong left[];
   return (CaiManagedTickets(left) == 0);
  }
//+------------------------------------------------------------------+
//| Move SL of one managed position; TP is preserved.                 |
//+------------------------------------------------------------------+
bool CaiModifySl(const ulong ticket, const double newSl, const double tp, uint &retcode)
  {
   bool ok = g_caiTrade.PositionModify(ticket, newSl, tp);
   retcode = g_caiTrade.ResultRetcode();
   return (ok && retcode == TRADE_RETCODE_DONE);
  }

//==================== end Execution.mqh ====================

enum ENUM_CAI_SIGNAL_SOURCE
  {
   CAI_SRC_AUTO   = 0,   // AUTO: bridge when live, replay file in the tester
   CAI_SRC_BRIDGE = 1,   // Local bridge (live/demo only)
   CAI_SRC_REPLAY = 2    // Replay CSV (Strategy Tester only)
  };

enum ENUM_CAI_LOT_MODE
  {
   CAI_LOT_FIXED      = 0,   // Fixed lot
   CAI_LOT_RISK_MONEY = 1    // Fixed money risk per trade (account currency)
  };

input group "=== Safety ==="
input bool   InpAllowOrders        = false;      // Allow the EA to send orders (opt-in)
input long   InpMagic              = 770001;     // Magic number (position ownership)
input string InpSymbolAllowlist    = "XAUUSD,XAUUSD.sc"; // Exact broker symbols allowed, comma separated

input group "=== Signal source ==="
input ENUM_CAI_SIGNAL_SOURCE InpSignalSource = CAI_SRC_AUTO;
input string InpBridgeUrl          = "http://127.0.0.1:8765";     // Loopback only; add to WebRequest list
input string InpBridgeTokenFile    = "claude_bridge_token.txt";   // In MQL5/Files (not the Anthropic key)
input int    InpHttpTimeoutMs      = 1500;       // Per HTTP call (bridge is local)
input int    InpSignalDeadlineSec  = 90;         // Give up (HOLD) if no final answer by then
input int    InpMaxSignalAgeSec    = 120;        // Stale-signal guard, seconds after bar close
input int    InpEvalIntervalSec    = 300;        // Minimum seconds between evaluated bars
input double InpMinConfidence      = 60.0;       // Uncalibrated model self-report, not a probability
input bool   InpSkipAiWhenBlocked  = true;       // Do not ask (or pay for) the AI when no action is possible
input string InpReplayFile         = "claude_replay_signals.csv"; // Terminal Common\Files (tester)

input group "=== Sessions (local exchange time, DST-aware) ==="
input bool   InpUseLondon          = true;
input int    InpLondonStartHHMM    = 800;        // Europe/London
input int    InpLondonEndHHMM      = 1700;
input bool   InpUseNewYork         = true;
input int    InpNewYorkStartHHMM   = 800;        // America/New_York
input int    InpNewYorkEndHHMM     = 1700;
input bool   InpUseAsia            = false;      // Asia blocked by default
input int    InpAsiaStartHHMM      = 900;        // Asia/Tokyo
input int    InpAsiaEndHHMM        = 1500;
input ENUM_CAI_SERVER_TIME_MODE InpServerTimeMode = CAI_SERVER_TIME_AUTO;
input int    InpServerStdOffsetHours = 2;        // MANUAL: broker winter offset from UTC
input ENUM_CAI_DST_RULE InpServerDstRule = CAI_DST_US;            // MANUAL: broker DST calendar

input group "=== Entry risk ==="
input ENUM_CAI_LOT_MODE InpLotMode = CAI_LOT_FIXED;
input double InpFixedLot           = 0.01;
input double InpRiskMoney          = 25.0;       // Used when lot mode = risk money
input double InpMaxSpreadPoints    = 35.0;
input int    InpMaxSlippagePoints  = 20;         // Max order deviation
input int    InpCooldownSec        = 900;
input int    InpMaxTradesPerDay    = 6;
input double InpMaxMarginUsePct    = 50.0;       // Order margin must be <= this % of free margin

input group "=== Stops (ATR multiples) ==="
input int    InpAtrPeriod          = 14;
input double InpSlAtr              = 1.0;
input double InpTpAtr              = 3.0;
input double InpBeTriggerAtr       = 1.0;        // Move SL to entry at +N ATR
input double InpTrailStartAtr      = 1.5;        // Start trailing at +N ATR
input double InpTrailDistAtr       = 1.0;        // Trailing distance
input int    InpBeBufferTicks      = 0;          // Optional BE offset in ticks (0 = exact entry)

input group "=== Account-currency stops ==="
input bool   InpDailyStops         = true;
input double InpDailyProfit        = 200.0;      // Latch when realized+floating >= this
input double InpDailyLoss          = 100.0;      // Latch when realized+floating <= -this
input bool   InpQuickProfit        = false;      // Optional
input double InpQuickProfitMoney   = 9.0;        // Close managed positions at this floating P/L

input group "=== Optional behaviour (OFF by default) ==="
input bool   InpReverseMode        = false;      // Opposite signal: close, verify, re-check, reverse
input bool   InpCloseOnHold        = false;      // HOLD closes the managed position
input bool   InpAuditLog           = true;

//--- state
#define ST_IDLE   0
#define ST_SUBMIT 1
#define ST_POLL   2

int      g_atrHandle      = INVALID_HANDLE;
bool     g_useReplay      = false;
bool     g_signalsEnabled = false;
bool     g_symbolOk       = false;
datetime g_lastEvalBar    = 0;

int      g_state          = ST_IDLE;
datetime g_reqBar         = 0;
string   g_reqId          = "";
string   g_reqBody        = "";
datetime g_reqDeadline    = 0;
int      g_reqSubmitTries = 0;
int      g_reqPollErrors  = 0;
ulong    g_reqStartMs     = 0;

bool     g_dailyOk        = false;   // false => P/L unknown => entries blocked
bool     g_dailyDirty     = true;
datetime g_dailyCalcAt    = 0;
double   g_realized       = 0.0;
double   g_floating       = 0.0;
int      g_tradesToday    = 0;
bool     g_latched        = false;
datetime g_lastCloseTry   = 0;
datetime g_lastModifyFail = 0;

//+------------------------------------------------------------------+
datetime ServerNow()
  {
   datetime t = TimeTradeServer();
   datetime c = TimeCurrent();
   return (t > c) ? t : c;
  }
//+------------------------------------------------------------------+
bool UtcNow(datetime &utc, int &offsetSec)
  {
   datetime now = ServerNow();
   if(!CaiServerUtcOffset(InpServerTimeMode, InpServerStdOffsetHours, InpServerDstRule, now, offsetSec))
     {
      utc = now;
      return false;
     }
   utc = now - offsetSec;
   return true;
  }
//+------------------------------------------------------------------+
double SpreadPoints()
  {
   MqlTick tick;
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   if(!SymbolInfoTick(_Symbol, tick) || point <= 0.0)
      return 1e9;                                            // unknown spread blocks entries
   return (tick.ask - tick.bid) / point;
  }
//+------------------------------------------------------------------+
void AuditEvent(const string event, const datetime barTime, const string requestId, const string signal,
         const double confidence, const string decision, const string reason,
         const double volume = 0.0, const double sl = 0.0, const double tp = 0.0,
         const ulong ticket = 0, const uint retcode = 0, const long latencyMs = 0)
  {
   datetime utc;
   int off;
   UtcNow(utc, off);
   CaiAudit(utc, event, _Symbol, barTime, requestId, signal, confidence, decision, reason,
            AccountInfoDouble(ACCOUNT_EQUITY), g_realized + g_floating, SpreadPoints(),
            volume, sl, tp, ticket, retcode, latencyMs);
  }
//+------------------------------------------------------------------+
bool SymbolInAllowlist()
  {
   string parts[];
   int n = StringSplit(InpSymbolAllowlist, ',', parts);
   for(int i = 0; i < n; i++)
     {
      string s = parts[i];
      StringTrimLeft(s);
      StringTrimRight(s);
      if(s != "" && s == _Symbol)
         return true;
     }
   return false;
  }
//+------------------------------------------------------------------+
bool InputsValid(string &why)
  {
   why = "";
   if(InpMagic <= 0)                                           why = "InpMagic must be > 0";
   else if(InpAtrPeriod < 2)                                   why = "InpAtrPeriod must be >= 2";
   else if(InpSlAtr <= 0.0 || InpTpAtr <= 0.0)                 why = "SL/TP ATR multiples must be > 0";
   else if(InpBeTriggerAtr <= 0.0 || InpTrailStartAtr < InpBeTriggerAtr || InpTrailDistAtr <= 0.0)
                                                               why = "BE/trailing ATR settings inconsistent";
   else if(InpBeBufferTicks < 0)                               why = "InpBeBufferTicks must be >= 0";
   else if(InpFixedLot <= 0.0 && InpLotMode == CAI_LOT_FIXED)  why = "InpFixedLot must be > 0";
   else if(InpRiskMoney <= 0.0 && InpLotMode == CAI_LOT_RISK_MONEY) why = "InpRiskMoney must be > 0";
   else if(InpMaxSpreadPoints <= 0.0)                          why = "InpMaxSpreadPoints must be > 0";
   else if(InpMaxSlippagePoints < 0)                           why = "InpMaxSlippagePoints must be >= 0";
   else if(InpMaxTradesPerDay < 1 || InpCooldownSec < 0)       why = "daily cap / cooldown invalid";
   else if(InpMaxMarginUsePct <= 0.0 || InpMaxMarginUsePct > 100.0) why = "InpMaxMarginUsePct must be in (0,100]";
   else if(InpMinConfidence < 0.0 || InpMinConfidence > 100.0) why = "InpMinConfidence must be 0..100";
   else if(InpHttpTimeoutMs < 100 || InpHttpTimeoutMs > 5000)  why = "InpHttpTimeoutMs must be 100..5000";
   else if(InpSignalDeadlineSec < 5 || InpSignalDeadlineSec > 280) why = "InpSignalDeadlineSec must be 5..280";
   else if(InpMaxSignalAgeSec < 1 || InpMaxSignalAgeSec > 295) why = "InpMaxSignalAgeSec must be 1..295";
   else if(InpEvalIntervalSec < 300)                           why = "InpEvalIntervalSec must be >= 300";
   else if(InpDailyStops && (InpDailyProfit < 0.0 || InpDailyLoss < 0.0)) why = "daily stop amounts must be >= 0";
   else if(InpQuickProfit && InpQuickProfitMoney <= 0.0)       why = "InpQuickProfitMoney must be > 0";
   else if(!CaiHhmmValid(InpLondonStartHHMM) || !CaiHhmmValid(InpLondonEndHHMM) ||
           !CaiHhmmValid(InpNewYorkStartHHMM) || !CaiHhmmValid(InpNewYorkEndHHMM) ||
           !CaiHhmmValid(InpAsiaStartHHMM) || !CaiHhmmValid(InpAsiaEndHHMM))
                                                               why = "session times must be HHMM";
   else if(InpServerStdOffsetHours < -12 || InpServerStdOffsetHours > 14) why = "InpServerStdOffsetHours invalid";
   return (why == "");
  }
//+------------------------------------------------------------------+
//| Remove per-position ATR records of positions that no longer exist.|
//+------------------------------------------------------------------+
void CleanupAtrRecords()
  {
   string prefix = CaiGvName("ATR_");
   ulong tickets[];
   CaiManagedTickets(tickets);
   for(int i = GlobalVariablesTotal() - 1; i >= 0; i--)
     {
      string name = GlobalVariableName(i);
      if(StringFind(name, prefix) != 0)
         continue;
      ulong ticket = (ulong)StringToInteger(StringSubstr(name, StringLen(prefix)));
      bool alive = false;
      for(int k = 0; k < ArraySize(tickets); k++)
         if(tickets[k] == ticket)
            alive = true;
      if(!alive)
         GlobalVariableDel(name);
     }
  }
//+------------------------------------------------------------------+
int OnInit()
  {
   string why;
   if(!InputsValid(why))
     {
      Alert("ClaudeEA: invalid inputs: ", why);
      return INIT_PARAMETERS_INCORRECT;
     }
   g_symbolOk = (CaiSymbolCharsOk(_Symbol) && SymbolInAllowlist());
   if(!g_symbolOk)
     {
      Alert("ClaudeEA: symbol ", _Symbol, " is not in InpSymbolAllowlist");
      return INIT_PARAMETERS_INCORRECT;
     }
   bool tester = (bool)MQLInfoInteger(MQL_TESTER);
   if(InpSignalSource == CAI_SRC_BRIDGE && tester)
     {
      Alert("ClaudeEA: the bridge (WebRequest) is not available in the Strategy Tester; use the replay file");
      return INIT_PARAMETERS_INCORRECT;
     }
   if(InpSignalSource == CAI_SRC_REPLAY && !tester)
     {
      Alert("ClaudeEA: replay signals are for the Strategy Tester only");
      return INIT_PARAMETERS_INCORRECT;
     }
   if(tester && InpServerTimeMode == CAI_SERVER_TIME_AUTO)
     {
      Alert("ClaudeEA: set InpServerTimeMode=MANUAL in the tester (UTC cannot be detected there)");
      return INIT_PARAMETERS_INCORRECT;
     }
   g_useReplay = tester;

   CaiExecInit(_Symbol, InpMagic, InpMaxSlippagePoints);
   CaiAuditInit(InpAuditLog, _Symbol, InpMagic);

   g_atrHandle = iATR(_Symbol, PERIOD_M5, InpAtrPeriod);
   if(g_atrHandle == INVALID_HANDLE)
     {
      Alert("ClaudeEA: cannot create ATR handle");
      return INIT_FAILED;
     }

   g_signalsEnabled = false;
   if(g_useReplay)
     {
      g_signalsEnabled = CaiReplayLoad(InpReplayFile);
      if(!g_signalsEnabled)
         Print("ClaudeEA: replay file missing or malformed -> all signals HOLD: ", InpReplayFile);
      else
         PrintFormat("ClaudeEA: replay signals loaded: %d rows", g_caiReplayCount);
     }
   else
     {
      if(!CaiBridgeUrlIsLocal(InpBridgeUrl))
         Alert("ClaudeEA: InpBridgeUrl must be http://127.0.0.1:<port> -> signals disabled (protection still active)");
      else if(!CaiBridgeLoadToken(InpBridgeTokenFile))
         Alert("ClaudeEA: bridge token file missing/invalid (MQL5\\Files\\", InpBridgeTokenFile,
               ") -> signals disabled (protection still active)");
      else
         g_signalsEnabled = true;
     }

   double v = 0.0;
   if(CaiGvGet("LASTEVALBAR", v))
      g_lastEvalBar = (datetime)(long)v;
   CleanupAtrRecords();
   g_dailyDirty = true;
   g_state = ST_IDLE;

   if(!EventSetTimer(1))
     {
      Alert("ClaudeEA: cannot start timer");
      return INIT_FAILED;
     }
   PrintFormat("ClaudeEA init: symbol=%s magic=%I64d orders=%s source=%s signals=%s reverse=%s holdClose=%s quickProfit=%s netting=%s",
               _Symbol, InpMagic, InpAllowOrders ? "ON" : "OFF", g_useReplay ? "replay" : "bridge",
               g_signalsEnabled ? "enabled" : "DISABLED", InpReverseMode ? "ON" : "OFF",
               InpCloseOnHold ? "ON" : "OFF", InpQuickProfit ? "ON" : "OFF", CaiIsNetting() ? "yes" : "no");
   AuditEvent("INIT", 0, "", "HOLD", 0.0, InpAllowOrders ? "ORDERS_ON" : "ORDERS_OFF",
       g_signalsEnabled ? "signals enabled" : "signals disabled");
   return INIT_SUCCEEDED;
  }
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   EventKillTimer();
   if(g_atrHandle != INVALID_HANDLE)
      IndicatorRelease(g_atrHandle);
   // Open positions keep their server-side SL/TP. Nothing is closed on deinit.
  }
//+------------------------------------------------------------------+
void OnTradeTransaction(const MqlTradeTransaction &trans, const MqlTradeRequest &request,
                        const MqlTradeResult &result)
  {
   g_dailyDirty = true;
  }
//+------------------------------------------------------------------+
//| Daily P/L + persistent latch. Realized P/L is rebuilt from broker |
//| history; the latch is stored in terminal GlobalVariables (flushed |
//| to disk), so both survive an EA or terminal restart.              |
//+------------------------------------------------------------------+
void UpdateDaily(const bool force)
  {
   datetime now = ServerNow();
   int day = CaiDayId(now);

   double gvDay = 0.0, gvLatch = 0.0;
   bool haveDay = CaiGvGet("DAY", gvDay);
   if(!haveDay || (int)gvDay != day)
     {
      // New broker day (or first run): reset the latch.
      if(!CaiGvSet("DAY", (double)day) || !CaiGvSet("LATCH", 0.0))
        {
         g_dailyOk = false;                                  // cannot persist -> do not trade
         return;
        }
      g_latched = false;
      g_dailyDirty = true;
     }
   else
     {
      CaiGvGet("LATCH", gvLatch);
      g_latched = (gvLatch != 0.0);
     }

   if(force || g_dailyDirty || now != g_dailyCalcAt)         // at most once per second unless forced
     {
      datetime dayStart = (datetime)((long)now - (long)now % 86400);
      double realized = 0.0;
      int entries = 0;
      if(CaiDayHistory(dayStart, now, realized, entries))
        {
         g_realized = realized;
         g_tradesToday = entries;
         g_dailyOk = true;
         g_dailyDirty = false;
        }
      else
         g_dailyOk = false;
      g_dailyCalcAt = now;
     }
   g_floating = CaiManagedFloating();

   if(InpDailyStops && g_dailyOk && !g_latched)
     {
      int breach = CaiDailyBreach(g_realized, g_floating, InpDailyProfit, InpDailyLoss);
      if(breach != 0)
        {
         g_latched = true;
         bool saved = CaiGvSet("LATCH", (double)breach);
         AuditEvent("DAILY_STOP", 0, "", "HOLD", 0.0, "LATCHED",
             StringFormat("%s; persisted=%s", breach == 1 ? "daily profit target" : "daily loss limit",
                          saved ? "yes" : "NO"));
        }
     }
  }
//+------------------------------------------------------------------+
double AtrForPosition(const ulong ticket, const double entry, const double tp)
  {
   double v = 0.0;
   if(CaiGvGet(StringFormat("ATR_%I64u", ticket), v) && v > 0.0)
      return v;                                              // ATR recorded at entry
   if(tp > 0.0 && InpTpAtr > 0.0)
      return MathAbs(tp - entry) / InpTpAtr;                 // TP was placed at entry +/- InpTpAtr*ATR
   double buf[];
   if(CopyBuffer(g_atrHandle, 0, 1, 1, buf) == 1 && buf[0] > 0.0)
      return buf[0];
   return 0.0;
  }
//+------------------------------------------------------------------+
//| Runs on every tick and every timer second. No HTTP, no AI.        |
//+------------------------------------------------------------------+
void Protect()
  {
   UpdateDaily(false);
   datetime now = ServerNow();
   ulong tickets[];
   int n = CaiManagedTickets(tickets);
   if(n == 0)
      return;

   //--- daily stop: close managed positions; repeat once per second until flat
   if(InpDailyStops && g_latched)
     {
      if(now != g_lastCloseTry)
        {
         g_lastCloseTry = now;
         uint rc = 0;
         bool flat = CaiCloseManaged(rc);
         g_dailyDirty = true;
         AuditEvent("DAILY_STOP_CLOSE", 0, "", "HOLD", 0.0, flat ? "CLOSED" : "CLOSE_PENDING", "daily stop latched",
             0.0, 0.0, 0.0, tickets[0], rc);
        }
      return;
     }

   //--- quick profit (optional): aggregate floating P/L of managed positions
   if(InpQuickProfit && g_floating >= InpQuickProfitMoney - CAI_EPS)
     {
      if(now != g_lastCloseTry)
        {
         g_lastCloseTry = now;
         uint rc = 0;
         bool flat = CaiCloseManaged(rc);
         g_dailyDirty = true;
         AuditEvent("QUICK_PROFIT", 0, "", "HOLD", 0.0, flat ? "CLOSED" : "CLOSE_PENDING",
             StringFormat("floating %.2f >= %.2f", g_floating, InpQuickProfitMoney), 0.0, 0.0, 0.0, tickets[0], rc);
        }
      return;
     }

   //--- break-even / trailing
   if(now == g_lastModifyFail)
      return;                                                // do not hammer the server after a rejection
   MqlTick tick;
   if(!SymbolInfoTick(_Symbol, tick))
      return;
   double point    = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double minDist  = (double)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * point;
   double freeze   = (double)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_FREEZE_LEVEL) * point;
   if(tickSize <= 0.0)
      return;
   for(int i = 0; i < n; i++)
     {
      if(!PositionSelectByTicket(tickets[i]))
         continue;
      bool   isBuy = ((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
      double entry = PositionGetDouble(POSITION_PRICE_OPEN);
      double sl    = PositionGetDouble(POSITION_SL);
      double tp    = PositionGetDouble(POSITION_TP);
      double price = isBuy ? tick.bid : tick.ask;
      double atr   = AtrForPosition(tickets[i], entry, tp);
      double newSl = CaiTrailSL(isBuy, entry, sl, price, atr, tickSize,
                                InpBeTriggerAtr, InpTrailStartAtr, InpTrailDistAtr,
                                InpBeBufferTicks, minDist, freeze);
      if(newSl <= 0.0)
         continue;
      // Defence in depth: never loosen a stop, whatever the calculation returned.
      if(sl > 0.0 && ((isBuy && newSl <= sl) || (!isBuy && newSl >= sl)))
         continue;
      uint rc = 0;
      bool ok = CaiModifySl(tickets[i], newSl, tp, rc);
      if(!ok)
         g_lastModifyFail = now;
      AuditEvent("SL_MOVE", 0, "", isBuy ? "BUY" : "SELL", 0.0, ok ? "MODIFIED" : "MODIFY_FAILED",
          StringFormat("sl %.5f -> %.5f", sl, newSl), PositionGetDouble(POSITION_VOLUME), newSl, tp, tickets[i], rc);
     }
  }
//+------------------------------------------------------------------+
//| A closed M5 bar that has not been evaluated yet (restart-safe).   |
//+------------------------------------------------------------------+
bool NextClosedBar(datetime &barTime)
  {
   datetime t1 = iTime(_Symbol, PERIOD_M5, 1);
   if(t1 <= 0 || t1 <= g_lastEvalBar)
      return false;
   if(g_lastEvalBar > 0 && (long)t1 - (long)g_lastEvalBar < InpEvalIntervalSec)
      return false;
   barTime = t1;
   return true;
  }
//+------------------------------------------------------------------+
void MarkEvaluated(const datetime barTime)
  {
   g_lastEvalBar = barTime;
   CaiGvSet("LASTEVALBAR", (double)(long)barTime);
  }
//+------------------------------------------------------------------+
long SignalAgeSec(const datetime barTime)
  {
   return (long)ServerNow() - ((long)barTime + 300);
  }
//+------------------------------------------------------------------+
//| Cheap pre-check before a paid AI call: returns a reason when no   |
//| signal could lead to any action right now, "" otherwise. Uses     |
//| only guards whose state cannot improve within one signal deadline.|
//| The full gate in TryEnter still runs on every signal.             |
//+------------------------------------------------------------------+
string AskBlockedReason()
  {
   if(!InpSkipAiWhenBlocked)
      return "";
   UpdateDaily(false);
   ulong tickets[];
   if(CaiManagedTickets(tickets) > 0)
     {
      // With a position open a signal matters only if it may close or reverse it.
      if(!InpReverseMode && !InpCloseOnHold)
         return "position open; reverse and HOLD-close are OFF";
      return "";
     }
   if(InpDailyStops && g_latched)
      return "daily stop latched";
   if(g_dailyOk && g_tradesToday >= InpMaxTradesPerDay)
      return "daily trade cap reached";
   datetime utc;
   int off = 0;
   string session = "NONE";
   if(!UtcNow(utc, off))
      return "server UTC offset unknown";
   if(!CaiSessionAllowed(utc, InpUseLondon, InpLondonStartHHMM, InpLondonEndHHMM,
                         InpUseNewYork, InpNewYorkStartHHMM, InpNewYorkEndHHMM,
                         InpUseAsia, InpAsiaStartHHMM, InpAsiaEndHHMM, session))
      return "outside allowed sessions";
   double lastEntry = 0.0;
   if(CaiGvGet("LASTENTRY", lastEntry) && lastEntry > 0.0 &&
      (long)ServerNow() - (long)lastEntry + InpSignalDeadlineSec < InpCooldownSec)
      return "cooldown active";
   return "";
  }
//+------------------------------------------------------------------+
//| All entry guards, in fixed order. The first failure blocks.       |
//| Mirrors refmodel/risk.py::entry_gate.                             |
//+------------------------------------------------------------------+
void TryEnter(const CaiSignal &sig, const datetime barTime, const string requestId, const long latencyMs)
  {
   string name = CaiSideName(sig.side);
   bool   isBuy = (sig.side == CAI_SIG_BUY);
   string block = "";
   double volume = 0.0, sl = 0.0, tp = 0.0, atr = 0.0;

   UpdateDaily(true);
   MqlTick tick;
   bool haveTick = SymbolInfoTick(_Symbol, tick);
   double point    = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double spread   = (haveTick && point > 0.0) ? (tick.ask - tick.bid) / point : 1e9;
   datetime utc;
   int off = 0;
   bool haveUtc = UtcNow(utc, off);
   string session = "NONE";
   double lastOrderBar = -1.0, lastEntry = 0.0;
   CaiGvGet("LASTORDERBAR", lastOrderBar);
   CaiGvGet("LASTENTRY", lastEntry);
   ulong tickets[];

   if(sig.side != CAI_SIG_BUY && sig.side != CAI_SIG_SELL)        block = "signal is HOLD/invalid";
   else if(!InpAllowOrders)                                       block = "live orders not enabled (InpAllowOrders=false)";
   else if(!CaiTradePermitted())                                  block = "trading not permitted";
   else if(!g_symbolOk)                                           block = "symbol not allowlisted";
   else if(sig.barTime != barTime || barTime != iTime(_Symbol, PERIOD_M5, 1))
                                                                  block = "signal is not for the last closed bar";
   else if(SignalAgeSec(barTime) > InpMaxSignalAgeSec || SignalAgeSec(barTime) < -5)
                                                                  block = "signal stale";
   else if((long)lastOrderBar == (long)barTime)                   block = "bar already traded (dedup)";
   else if(sig.confidence < InpMinConfidence)                     block = "confidence below minimum";
   else if(!g_dailyOk)                                            block = "daily P/L unavailable";
   else if(InpDailyStops && g_latched)                            block = "daily stop latched";
   else if(!haveUtc)                                              block = "server UTC offset unknown";
   else if(!CaiSessionAllowed(utc, InpUseLondon, InpLondonStartHHMM, InpLondonEndHHMM,
                              InpUseNewYork, InpNewYorkStartHHMM, InpNewYorkEndHHMM,
                              InpUseAsia, InpAsiaStartHHMM, InpAsiaEndHHMM, session))
                                                                  block = "outside allowed sessions";
   else if(!haveTick || spread > InpMaxSpreadPoints)              block = "spread above limit";
   else if(g_tradesToday >= InpMaxTradesPerDay)                   block = "daily trade cap reached";
   else if(lastEntry > 0.0 && (long)ServerNow() - (long)lastEntry < InpCooldownSec)
                                                                  block = "cooldown active";
   else if(CaiForeignPositionOnNetting())                         block = "netting account holds a non-EA position on this symbol";
   else if(CaiManagedTickets(tickets) != 0)                       block = "managed position already open";
   else
     {
      double buf[];
      if(CopyBuffer(g_atrHandle, 0, 1, 1, buf) != 1 || !(buf[0] > 0.0) || !MathIsValidNumber(buf[0]) || tickSize <= 0.0)
         block = "ATR unavailable";
      else
        {
         atr = buf[0];
         double entry = isBuy ? tick.ask : tick.bid;
         CaiInitialStops(isBuy, entry, atr, tickSize, InpSlAtr, InpTpAtr, sl, tp);
         double raw = (InpLotMode == CAI_LOT_FIXED) ? InpFixedLot : CaiVolumeForRisk(isBuy, entry, sl, InpRiskMoney);
         volume = CaiNormalizeVolume(raw, SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN),
                                     SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX),
                                     SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP));
         double minDist = (double)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * point;
         if(volume <= 0.0)                                          block = "volume below broker minimum";
         else if(!CaiStopsValid(isBuy, tick.bid, tick.ask, sl, tp, minDist))
                                                                    block = "SL/TP violate broker stop level";
         else if(!CaiMarginOk(isBuy, volume, entry, InpMaxMarginUsePct))
                                                                    block = "insufficient free margin";
        }
     }

   if(block != "")
     {
      AuditEvent("GATE", barTime, requestId, name, sig.confidence, "BLOCKED", block, volume, sl, tp, 0, 0, latencyMs);
      return;
     }

   // Write-ahead de-duplication: record the bar BEFORE sending. If the terminal dies between
   // these two steps the bar is skipped, never traded twice. The order itself is never retried.
   if(!CaiGvSet("LASTORDERBAR", (double)(long)barTime))
     {
      AuditEvent("GATE", barTime, requestId, name, sig.confidence, "BLOCKED", "cannot persist dedup state", volume, sl, tp);
      return;
     }
   uint  retcode = 0;
   ulong order = 0;
   bool ok = CaiOpen(isBuy, volume, sl, tp, "ClaudeEA", retcode, order);
   g_dailyDirty = true;
   if(ok)
     {
      CaiGvSet("LASTENTRY", (double)(long)ServerNow());
      ulong opened[];
      int n = CaiManagedTickets(opened);
      for(int i = 0; i < n; i++)
        {
         string key = StringFormat("ATR_%I64u", opened[i]);
         double dummy = 0.0;
         if(!CaiGvGet(key, dummy))
            CaiGvSet(key, atr);
        }
     }
   AuditEvent("ORDER", barTime, requestId, name, sig.confidence, ok ? "SENT" : "REJECTED",
       StringFormat("session=%s atr=%.5f", session, atr), volume, sl, tp, order, retcode, latencyMs);
  }
//+------------------------------------------------------------------+
//| Act on one FINAL signal for one closed bar.                       |
//+------------------------------------------------------------------+
void HandleSignal(const CaiSignal &sig, const datetime barTime, const string requestId, const long latencyMs)
  {
   string name = CaiSideName(sig.side);
   AuditEvent("SIGNAL", barTime, requestId, name, sig.confidence, "RECEIVED", sig.source + ": " + sig.reason,
       0.0, 0.0, 0.0, 0, 0, latencyMs);

   ulong tickets[];
   int n = CaiManagedTickets(tickets);
   int posSide = CAI_SIG_HOLD;
   if(n > 0 && PositionSelectByTicket(tickets[0]))
      posSide = ((ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? CAI_SIG_BUY : CAI_SIG_SELL;

   if(sig.side == CAI_SIG_HOLD)
     {
      // HOLD never closes a position unless the operator explicitly enabled it.
      if(InpCloseOnHold && n > 0)
        {
         uint rc = 0;
         bool flat = CaiCloseManaged(rc);
         g_dailyDirty = true;
         AuditEvent("HOLD_CLOSE", barTime, requestId, name, 0.0, flat ? "CLOSED" : "CLOSE_FAILED", "InpCloseOnHold",
             0.0, 0.0, 0.0, tickets[0], rc);
        }
      return;
     }
   if(n > 0 && posSide == sig.side)
     {
      AuditEvent("GATE", barTime, requestId, name, sig.confidence, "NO_ACTION", "managed position already in this direction");
      return;
     }
   if(n > 0)
     {
      if(!InpReverseMode)
        {
         AuditEvent("GATE", barTime, requestId, name, sig.confidence, "IGNORED", "opposite signal; reverse mode is OFF");
         return;
        }
      if(!InpAllowOrders || sig.confidence < InpMinConfidence || sig.barTime != barTime ||
         SignalAgeSec(barTime) > InpMaxSignalAgeSec)
        {
         AuditEvent("GATE", barTime, requestId, name, sig.confidence, "BLOCKED", "reverse pre-check failed; position kept");
         return;
        }
      uint rc = 0;
      bool flat = CaiCloseManaged(rc);
      g_dailyDirty = true;
      AuditEvent("REVERSE_CLOSE", barTime, requestId, name, sig.confidence, flat ? "CLOSED" : "CLOSE_NOT_VERIFIED",
          "reverse mode", 0.0, 0.0, 0.0, tickets[0], rc);
      if(!flat)
         return;                                             // never open against a position that may still exist
     }
   TryEnter(sig, barTime, requestId, latencyMs);             // full gate re-check (incl. daily stop) before any order
  }
//+------------------------------------------------------------------+
//| Strategy Tester path: historical replay, no HTTP.                 |
//+------------------------------------------------------------------+
void ReplayStep()
  {
   datetime barTime;
   if(!NextClosedBar(barTime))
      return;
   MarkEvaluated(barTime);
   if(!g_signalsEnabled)
      return;
   CaiSignal sig;
   CaiReplayLookup(barTime, sig);
   HandleSignal(sig, barTime, CaiRequestId(_Symbol, barTime, InpMagic), 0);
  }
//+------------------------------------------------------------------+
void FinishRequest(const string decision, const string reason)
  {
   AuditEvent("SIGNAL", g_reqBar, g_reqId, "HOLD", 0.0, decision, reason, 0.0, 0.0, 0.0, 0, 0,
       (long)(GetTickCount64() - g_reqStartMs));
   g_state = ST_IDLE;
  }
//+------------------------------------------------------------------+
//| Live path, called once per second from OnTimer. At most ONE short |
//| HTTP call per invocation; retries/backoff live in the bridge.     |
//+------------------------------------------------------------------+
void BridgeStep()
  {
   if(g_state == ST_IDLE)
     {
      datetime barTime;
      if(!NextClosedBar(barTime))
         return;
      MarkEvaluated(barTime);
      g_reqBar = barTime;
      g_reqId = CaiRequestId(_Symbol, barTime, InpMagic);
      g_reqStartMs = GetTickCount64();
      if(!g_signalsEnabled)
         return;
      if(SignalAgeSec(barTime) > InpMaxSignalAgeSec)
        {
         FinishRequest("SKIPPED", "bar already stale (market gap or late start)");
         return;
        }
      string skip = AskBlockedReason();
      if(skip != "")
        {
         FinishRequest("NOT_ASKED", skip);                   // no HTTP, no API cost
         return;
        }
      MqlRates rates[];
      ArraySetAsSeries(rates, false);
      double atr[];
      int off = 0;
      datetime utc;
      if(CopyRates(_Symbol, PERIOD_M5, 1, 20, rates) != 20 || rates[19].time != barTime ||
         CopyBuffer(g_atrHandle, 0, 1, 1, atr) != 1 || !UtcNow(utc, off) ||
         !CaiBuildRequest(_Symbol, g_reqId, rates, atr[0], SpreadPoints(), off, g_reqBody))
        {
         FinishRequest("HOLD", "market data incomplete or malformed");
         return;
        }
      g_reqDeadline = ServerNow() + InpSignalDeadlineSec;
      g_reqSubmitTries = 0;
      g_reqPollErrors = 0;
      g_state = ST_SUBMIT;
     }

   // A newer bar has closed, or the deadline passed: the pending answer is worthless.
   if(iTime(_Symbol, PERIOD_M5, 1) != g_reqBar || ServerNow() > g_reqDeadline)
     {
      FinishRequest("HOLD", "no final signal before deadline");
      return;
     }

   string response = "";
   CaiSignal sig;
   int status = -1;
   int result = CAI_BRIDGE_ERROR;
   if(g_state == ST_SUBMIT)
     {
      g_reqSubmitTries++;
      status = CaiHttp("POST", InpBridgeUrl + "/v1/signal", g_reqBody, InpHttpTimeoutMs, response);
      result = CaiParseResponse(status, response, g_reqId, g_reqBar, sig);
      if(result == CAI_BRIDGE_ERROR)
        {
         // The POST is idempotent (request id), so one more attempt on the next second is safe.
         if(status == -1 && g_reqSubmitTries < 2)
            return;
         FinishRequest("HOLD", sig.reason);
         return;
        }
     }
   else
     {
      status = CaiHttp("GET", InpBridgeUrl + "/v1/signal/" + g_reqId, "", InpHttpTimeoutMs, response);
      result = CaiParseResponse(status, response, g_reqId, g_reqBar, sig);
      if(result == CAI_BRIDGE_ERROR)
        {
         g_reqPollErrors++;
         if(g_reqPollErrors < 3 && status == -1)
            return;
         FinishRequest("HOLD", sig.reason);
         return;
        }
     }
   if(result == CAI_BRIDGE_PENDING)
     {
      g_state = ST_POLL;
      return;
     }
   g_state = ST_IDLE;
   HandleSignal(sig, g_reqBar, g_reqId, (long)(GetTickCount64() - g_reqStartMs));
  }
//+------------------------------------------------------------------+
void OnTick()
  {
   Protect();                       // position protection first, on every tick
   if(g_useReplay)
      ReplayStep();                 // tester: one evaluation per new closed bar
  }
//+------------------------------------------------------------------+
void OnTimer()
  {
   Protect();                       // also when the market is quiet
   if(!g_useReplay)
      BridgeStep();                 // live: all HTTP happens here, never in OnTick
  }
//+------------------------------------------------------------------+
