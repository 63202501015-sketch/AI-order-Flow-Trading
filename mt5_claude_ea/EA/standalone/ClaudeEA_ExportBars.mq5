// STANDALONE BUILD - generated by tools_mql_bundle.py from the modular sources.
// Do not edit here; edit EA/Include/ClaudeEA/*.mqh and regenerate.

//+------------------------------------------------------------------+
//| ClaudeEA_ExportBars.mq5 - export closed M5 bars of the chart      |
//| symbol to Common\Files\<symbol>_M5.csv in the format read by      |
//| `python -m replay.generate`. Times are broker-server epoch secs,  |
//| the same clock the EA uses to look signals up in the tester.      |
//+------------------------------------------------------------------+
#property script_show_inputs
#property version "1.00"

input int InpBars = 20000;     // Number of closed bars to export

void OnStart()
  {
   MqlRates rates[];
   ArraySetAsSeries(rates, false);
   int n = CopyRates(_Symbol, PERIOD_M5, 1, InpBars, rates);     // shift 1: closed bars only
   if(n <= 0)
     {
      Print("ExportBars: no data, error ", GetLastError());
      return;
     }
   string name = _Symbol + "_M5.csv";
   int h = FileOpen(name, FILE_WRITE | FILE_TXT | FILE_ANSI | FILE_COMMON);
   if(h == INVALID_HANDLE)
     {
      Print("ExportBars: cannot open file, error ", GetLastError());
      return;
     }
   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   FileWriteString(h, "time,open,high,low,close,spread_points\r\n");
   for(int i = 0; i < n; i++)
      FileWriteString(h, StringFormat("%I64d,%s,%s,%s,%s,%d\r\n", (long)rates[i].time,
                                      DoubleToString(rates[i].open, digits), DoubleToString(rates[i].high, digits),
                                      DoubleToString(rates[i].low, digits), DoubleToString(rates[i].close, digits),
                                      rates[i].spread));
   FileClose(h);
   PrintFormat("ExportBars: %d bars -> Common\\Files\\%s", n, name);
  }
//+------------------------------------------------------------------+
